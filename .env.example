CEO_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
COOKIE_SECURE=false
DATABASE_PATH=./office.sqlite3

# Optional per-staff OpenAI Agents API sessions
STAFF_PLATFORM_ENABLED=false
# Set server-side using a project key authorized for Agents sessions.
STAFF_PLATFORM_API_KEY=
# Optional JSON object mapping Obscura staff IDs to distinct saved agent IDs.
STAFF_PLATFORM_AGENT_IDS={}

# Optional read-only cloud browser for public HTTPS references in staff task briefs.
CLOUDFLARE_BROWSER_ACCOUNT_ID=
CLOUDFLARE_BROWSER_API_TOKEN=
